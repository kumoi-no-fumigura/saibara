   "poems": [],
   "pid": "1913603"
  },
  {
   "id": "saibara-000068",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "妹與我",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "いもとわれと。妹と我と。いるさの山の。山蘭。手な觸れそヤ。香を薰す(ィまさる)がにヤ。香を(ィとく)增さすがにや。",
   "yomi": "",
   "jo": false,
   "pages": [
    84
   ],
   "no": 68,
   "poems": [],
   "notes": [
