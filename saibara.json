  {
   "id": "saibara-000065",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "一段",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "みまさかや。くめの。久米の佐良山。さら〳〵に。ナヨヤ。さら〳〵に。ナヨヤ。",
   "yomi": "",
   "jo": false,
   "pages": [
    83
   ],
   "no": 65,
   "poems": [],
   "notes": [
    {
     "a": "みまさかや",
     "n": "此歌古今集に出づ みまさかや云々 上二句「さら〳〵に」の序",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "saibara-000066",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "二段",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "さら〳〵に。わがな。我名はたえじ。よろづよまでにャ。萬代までにャ。ふぢふのの。かたち。かたちが原に。しめはやし。ナヨヤ。しめはやし。ナヨヤ。",
   "yomi": "",
   "jo": false,
   "pages": [
    83,
    84
   ],
   "no": 66,
   "poems": [],
   "notes": [
    {
     "a": "我名はたえじ",
     "n": "てイ",
     "k": "校異"
    },
    {
     "a": "ふぢふのの",
     "n": "藤生野ー山城",
     "k": "頭注"
    },
    {
     "a": "かたちが原に",
     "n": "をイ",
     "k": "校異"
    },
    {
     "a": "かたちが原に",
     "n": "しめはやしー定めたる意",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "saibara-000067",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "二段",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "しめはやし。いつき。いはひしも(イになし)しるく(ィし)。時にあへるかも(ィヤ)。時にあへるかもヤ。",
   "yomi": "",
   "jo": false,
   "pages": [
