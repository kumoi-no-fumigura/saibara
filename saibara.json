     "n": "三つば四つば―三棟四棟、子孫一族の榮ゆるをいふ也",
     "k": "頭注"
    },
    {
     "a": "宜も富みけり",
     "n": "イになし",
     "k": "校異"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "saibara-000055",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "二段",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "さき草の。三つば四つばの中に。殿づくりせりャ。とのづくりせりヤ。",
   "yomi": "",
   "jo": false,
   "pages": [
    83
   ],
   "no": 55,
   "poems": [],
   "notes": [
    {
     "a": "三つば四つば",
     "n": "三つば四つばー三棟四棟、子孫一族の繁ゆるをいふ也",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "saibara-000056",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "此殿西",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "",
   "yomi": "",
