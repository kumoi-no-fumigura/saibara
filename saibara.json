   "bu": "",
   "dai": "二段",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "をくをなみ。わがす。わがする時に。會へる夫かもヤ。あへるせなかも。",
