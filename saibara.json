  {
   "id": "saibara-000062",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "一段",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "たか山に。たかを。鷹を放ちあげて。招くよしを無み。アハレ。をくをなみ。ハレ。",
   "yomi": "",
   "jo": false,
   "pages": [
    83
   ],
   "no": 62,
   "poems": [],
   "notes": [
    {
     "a": "鷹を放ちあげて",
     "n": "イになし",
     "k": "校異"
    },
